{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shoulongwu/typstrxp/schemas/c0-repair-packet.schema.json",
  "title": "C0 repair packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "original_task",
    "source_before",
    "target_start",
    "target_end",
    "target_block",
    "selected_diagnostic",
    "target_diagnostics"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "original_task": {"type": "string", "minLength": 1},
    "source_before": {"type": "string", "minLength": 1},
    "target_start": {"type": "integer", "minimum": 0},
    "target_end": {"type": "integer", "minimum": 1},
    "target_block": {"type": "string", "minLength": 1},
    "selected_diagnostic": {"type": "string", "minLength": 1},
    "target_diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "dependency_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "evidence"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
